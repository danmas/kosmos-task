30\u043d\u0438\u0435: \u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u0446\u0435\u043b\u044c \u0437\u0430\u0434\u0430\u0447\u0438", "file_type": "image", "source_file": "screenshot-factory-1-initial.png", "description": "\u041f\u043e\u044f\u0441\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442 \u043f\u043e\u0434 \u0442\u0430\u0431\u0430\u043c\u0438: '\u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u0446\u0435\u043b\u044c \u0437\u0430\u0434\u0430\u0447\u0438 \u2014 LLM \u0437\u0430\u0434\u0430\u0441\u0442 \u0443\u0442\u043e\u0447\u043d\u044f\u044e\u0449\u0438\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u0434\u043b\u044f \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0430.'"}, {"id": "screenshot-factory-1-initial_goal_input", "label": "Goal Input: \u0426\u0435\u043b\u044c \u0437\u0430\u0434\u0430\u0447\u0438", "file_type": "image", "source_file": "screenshot-factory-1-initial.png", "description": "\u0422\u0435\u043a\u0441\u0442\u043e\u0432\u043e\u0435 \u043f\u043e\u043b\u0435 \u0432\u0432\u043e\u0434\u0430 \u0446\u0435\u043b\u0438 \u0437\u0430\u0434\u0430\u0447\u0438 \u0441 placeholder '\u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440: \u0421\u043e\u0437\u0434\u0430\u0442\u044c \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440 Fibonacci \u0441 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u043e\u0439 \u0447\u0451\u0442\u043d\u043e\u0441\u0442\u0438' \u2014 \u043f\u0443\u0441\u0442\u043e\u0435 \u0432 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438"}, {"id": "screenshot-factory-1-initial_task_count_select", "label": "Select: \u041f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0430 \u0437\u0430\u0434\u0430\u0447 (default: 2)", "file_type": "image", "source_file": "screenshot-factory-1-initial.png", "description": "\u0412\u044b\u043f\u0430\u0434\u0430\u044e\u0449\u0438\u0439 \u0441\u043f\u0438\u0441\u043e\u043a '\u041f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0430: \u0437\u0430\u0434\u0430\u0447' \u0441\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u043c\u0438 1/2/3, \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0432\u044b\u0431\u0440\u0430\u043d\u043e 2"}, {"id": "screenshot-factory-1-initial_steps_per_task_select", "label": "Select: \u041f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0430 \u0448\u0430\u0433\u043e\u0432 (default: 2)", "file_type": "image", "source_file": "screenshot-factory-1-initial.png", "description": "\u0412\u044b\u043f\u0430\u0434\u0430\u044e\u0449\u0438\u0439 \u0441\u043f\u0438\u0441\u043e\u043a '\u041f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0430: \u0448\u0430\u0433\u043e\u0432' \u0441\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u043c\u0438 1/2/3, \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0432\u044b\u0431\u0440\u0430\u043d\u043e 2"}, {"id": "screenshot-factory-1-initial_ask_button", "label": "Button: \u2753 \u0417\u0430\u0434\u0430\u0442\u044c \u0432\u043e\u043f\u0440\u043e\u0441\u044b", "file_type": "image", "source_file": "screenshot-factory-1-initial.png", "description": "\u0424\u0438\u043e\u043b\u0435\u0442\u043e\u0432\u0430\u044f/\u0430\u043a\u0446\u0435\u043d\u0442\u043d\u0430\u044f \u043a\u043d\u043e\u043f\u043a\u0430 '\u2753 \u0417\u0430\u0434\u0430\u0442\u044c \u0432\u043e\u043f\u0440\u043e\u0441\u044b' \u2014 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0446\u0435\u043b\u044c \u043d\u0430 LLM \u0434\u043b\u044f \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432"}, {"id": "screenshot-factory-1-initial_view_prompt_button", "label": "Button: \ud83d\udcc4 \u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u0440\u043e\u043c\u043f\u0442", "file_type": "image", "source_file": "screenshot-factory-1-initial.png", "description": "