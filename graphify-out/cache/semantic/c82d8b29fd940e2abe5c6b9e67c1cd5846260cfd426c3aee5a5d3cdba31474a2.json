{"nodes": [{"id": "screenshot-edit-flow-4-reset_factory_page", "label": "\u0424\u0430\u0431\u0440\u0438\u043a\u0430 \u0437\u0430\u0434\u0430\u0447 (Task Factory Page)", "file_type": "image", "source_file": "screenshot-edit-flow-4-reset.png", "description": "\u0413\u043b\u0430\u0432\u043d\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0444\u0430\u0431\u0440\u0438\u043a\u0438 \u0437\u0430\u0434\u0430\u0447 kosmos-task UI \u043f\u043e\u0441\u043b\u0435 \u0441\u0431\u0440\u043e\u0441\u0430 \u043f\u0440\u043e\u043c\u043f\u0442\u0430"}, {"id": "screenshot-edit-flow-4-reset_prompt_modal", "label": "Prompt Modal (\u043f\u043e\u0441\u043b\u0435 \u0441\u0431\u0440\u043e\u0441\u0430)", "file_type": "image", "source_file": "screenshot-edit-flow-4-reset.png", "description": "\u041c\u043e\u0434\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u043a\u043d\u043e \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u0440\u043e\u043c\u043f\u0442\u0430 \u043f\u043e\u0441\u043b\u0435 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0433\u043e \u0441 \u0434\u0438\u0441\u043a\u0430"}, {"id": "screenshot-edit-flow-4-reset_modal_overlay", "label": "Modal Overlay", "file_type": "image", "source_file": "screenshot-edit-flow-4-reset.png", "description": "\u041f\u043e\u043b\u0443\u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u044b\u0439 \u0442\u0451\u043c\u043d\u044b\u0439 \u0444\u043e\u043d, \u043f\u0435\u0440\u0435\u043a\u0440\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u043f\u0440\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0439 \u043c\u043e\u0434\u0430\u043b\u043a\u0435"}, {"id": "screenshot-edit-flow-4-reset_modal_header", "label": "Modal Header", "file_type": "image", "source_file": "screenshot-edit-flow-4-reset.png", "description": "\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u043c\u043e\u0434\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u043a\u043d\u0430 \u0441 \u0438\u043a\u043e\u043d\u043a\u043e\u0439, \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c \u043f\u0440\u043e\u043c\u043f\u0442\u0430 \u0438 \u0438\u043c\u0435\u043d\u0435\u043c \u0444\u0430\u0439\u043b\u0430"}, {"id": "screenshot-edit-flow-4-reset_prompt_title", "label": "\ud83d\udcc4 \u041f\u0440\u043e\u043c\u043f\u0442: \u0423\u0442\u043e\u0447\u043d\u044f\u044e\u0449\u0438\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b / \u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f .kosmos.md", "file_type": "image", "source_file": "screenshot-edit-flow-4-reset.png", "description": "\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u043c\u043e\u0434\u0430\u043b\u043a\u0438 \u2014 \u0442\u043e\u0442 \u0436\u0435, \u0447\u0442\u043e \u0431\u044b\u043b \u0434\u043e \u0441\u0431\u0440\u043e\u0441\u0430"}, {"id": "screenshot-edit-flow-4-reset_edit_button", "label": "\u270f\ufe0f \u0420\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c Button", "file_type": "image", "source_file": "screenshot-edit-flow-4-reset.png", "description": "\u041a\u043d\u043e\u043f\u043a\u0430 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0432 \u0440\u0435\u0436\u0438\u043c \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u043e\u043c\u043f\u0442\u0430 (\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u043f\u043e\u0441\u043b\u0435 \u0441\u0431\u0440\u043e\u0441\u0430)"}, {"id": "screenshot-edit-flow-4-reset_reset_button_disabled", "label": "\u21ba \u0421\u0431\u0440\u043e\u0441\u0438\u0442\u044c Button (disabled)", "file_type": "image", "source_file": "screenshot-edit-flow-4-reset.png", "description": "\u041a\u043d\u043e\u043f\u043a\u0430 \u0441\u0431\u0440\u043e\u0441\u0430 \u043f\u0440\u043e\