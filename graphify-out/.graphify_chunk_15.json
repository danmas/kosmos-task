    {
      "id": "screenshot-test-2-after-edit-click_editor_page",
      "name": "Editor Page (Редактирование)",
      "type": "page",
      "description": "Страница редактора в режиме редактирования (mode='edit'). Открыта после клика по кнопке 'Редактировать' на существующей задаче. Содержит заголовок '✏️ Редактирование', отображение имени файла, панель инструментов и текстовый редактор с загруженным содержимым файла",
      "file_type": "image",
      "source_files": [
        "C:\\ERV\\projects-ex\\kosmos-task\\screenshot-test-2-after-edit-click.png",
        "C:\\ERV\\projects-ex\\kosmos-task\\ui\\pages\\editor.js"
      ],
      "metadata": {
        "mode": "edit",
        "trigger": "click_edit_on_task"
      }
    },
    {
      "id": "screenshot-test-2-after-edit-click_page_header",
      "name": "Page Header «← ✏️ Редактирование»",
      "type": "ui_element",
      "description": "Заголовок страницы: кнопка назад (←) для возврата на дашборд (app.navigate('dashboard')) и текст '✏️ Редактирование'. Отличается от режима create, где отображается '✏️ Новая задача'",
