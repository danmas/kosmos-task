        "action": "EditorPage.validate()",
        "button_style": "btn-secondary"
      }
    },
    {
      "id": "screenshot-test-2-after-edit-click_save_button",
      "name": "Button: 💾 Сохранить",
      "type": "ui_element",
      "description": "Основная кнопка '💾 Сохранить' (btn-primary) — вызывает EditorPage.save() для сохранения изменений в существующий файл через PUT /files/:filename",
      "file_type": "image",
      "source_files": [
        "C:\\ERV\\projects-ex\\kosmos-task\\screenshot-test-2-after-edit-click.png",
        "C:\\ERV\\projects-ex\\kosmos-task\\ui\\pages\\editor.js"
      ],
      "metadata": {
        "action": "EditorPage.save()",
        "http_method": "PUT",
        "endpoint": "/files/:filename"
      }
    },
    {
      "id": "screenshot-test-2-after-edit-click_validation_area",
      "name": "Validation Result Area (пусто или с результатом)",
      "type": "ui_element",
      "description": "Область отображения результата валидации (id='validationResult') — расположена под заголовком, над текстовым редактором. При открытии редактора может быть пустой или содержать результат последней валидации",
      "file_type": "image",
      "source_files": [
        "C:\\ERV\\projects-ex\\kosmos-task\\screenshot-test-2-after-edit-click.png",
